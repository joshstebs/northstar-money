generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) createdAt DateTime @default(now()) accounts Account[] connections Connection[] }
model Connection { id String @id @default(cuid()) userId String provider String providerItemId String? encryptedAccessToken String? cursor String? status String @default("active") createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) accounts Account[] @@index([userId]) }
model Account { id String @id @default(cuid()) userId String connectionId String? providerAccountId String name String mask String? type String subtype String? currency String @default("CAD") currentBalance Decimal? availableBalance Decimal? user User @relation(fields:[userId],references:[id],onDelete:Cascade) connection Connection? @relation(fields:[connectionId],references:[id]) transactions Transaction[] @@unique([providerAccountId,connectionId]) }
model Transaction { id String @id @default(cuid()) accountId String providerTransactionId String merchantName String? description String amount Decimal date DateTime pending Boolean @default(false) category String? subcategory String? isRecurring Boolean @default(false) account Account @relation(fields:[accountId],references:[id],onDelete:Cascade) @@unique([accountId,providerTransactionId]) @@index([date]) }
model Budget { id String @id @default(cuid()) category String month DateTime amount Decimal }
model Goal { id String @id @default(cuid()) name String targetAmount Decimal targetDate DateTime? currentAmount Decimal @default(0) }
model Insight { id String @id @default(cuid()) type String title String body String amount Decimal? confidence Float? createdAt DateTime @default(now()) dismissed Boolean @default(false) }
