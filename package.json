  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "auth:hash": "node scripts/generate-password-hash.mjs",
    "config:check": "node scripts/verify-production.mjs",
