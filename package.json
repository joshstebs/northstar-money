    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-plaid-link": "^4.0.1",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.16.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
